<UserControl x:Class="Pos.App.Views.LedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBg}">
    <UserControl.Resources>
        <Style x:Key="MiniBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="7" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HdrBtn" TargetType="Button">
            <Setter Property="Height" Value="36"/><Setter Property="Padding" Value="14,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/><Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Customer Ledger" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Manage customer credit accounts, debits, credits, and transaction logs." Foreground="{StaticResource TextMuted}" FontSize="12"/>
            </StackPanel>
            <Button Content="+  ADD CUSTOMER" Click="AddCustomer_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="38" Padding="18,0" Cursor="Hand" Background="{StaticResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0"/>
        </Grid>

        <!-- Summary cards -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="#40EF4444" BorderThickness="1" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL RECEIVABLE" Foreground="#FFEF4444" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalGaveBalance, StringFormat='₹{0:N0}'}" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="44" Height="44" CornerRadius="11" Background="#1AEF4444" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="↗" FontSize="20" FontWeight="Bold" Foreground="#FFEF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="#4022C55E" BorderThickness="1" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL PREPAID / ADVANCE" Foreground="#FF22C55E" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TotalGotBalance, StringFormat='₹{0:N0}'}" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="44" Height="44" CornerRadius="11" Background="#1A22C55E" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="↙" FontSize="20" FontWeight="Bold" Foreground="#FF22C55E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="4" Background="{StaticResource CardBg}" CornerRadius="12" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TOTAL CUSTOMERS" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CustomerCount}" Foreground="White" FontSize="22" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="44" Height="44" CornerRadius="11" Background="{StaticResource AccentFaint}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: customer list -->
            <Border Grid.Column="0" Background="{StaticResource PanelBg}" CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,7">
                            <Grid>
                                <TextBlock Text="🔍  Search customer by name or mobile" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding SearchText, Converter={StaticResource StringToVis}}"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="13" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource Accent}"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="2" Content="+" Click="AddCustomer_Click" Width="40" Height="38" Cursor="Hand" FontSize="18" FontWeight="Bold"
                                Background="{StaticResource AccentGrad}" Foreground="White" BorderThickness="0"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding FilteredCustomers}" SelectedItem="{Binding SelectedCustomer}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="b" CornerRadius="12" Padding="14,12" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" Cursor="Hand">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedBalance}" Foreground="#FFEF4444" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right: detail -->
            <Border Grid.Column="2" Background="{StaticResource PanelBg}" CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="20">
                <Grid>
                    <!-- placeholder -->
                    <TextBlock Text="Select a customer to view ledger" Foreground="{StaticResource TextFaint}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding SelectedCustomer.Name, Converter={StaticResource StringToVis}}"/>

                    <!-- detail -->
                    <Grid Visibility="{Binding SelectedCustomer.Name, Converter={StaticResource StringToVis}, ConverterParameter=invert}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedCustomer.Name}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource MiniBtn}" Content="✎" Click="EditCustomer_Click" ToolTip="Edit customer" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding SelectedCustomer.PhoneDisplay}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="•" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding SelectedCustomer.AddressDisplay}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource HdrBtn}" Content="WHATSAPP SHARE" Click="Share_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource HdrBtn}" Content="PRINT STATEMENT" Click="Print_Click" Margin="0,0,8,0"/>
                                <Button Content="+  NEW TRANSACTION" Click="NewTransaction_Click" Height="36" Padding="14,0" Cursor="Hand"
                                        Background="{StaticResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="11.5" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 3 sub-cards -->
                        <Grid Grid.Row="1" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="TOTAL DEBITED (BORROW)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedDebited, StringFormat='₹{0:N0}'}" Foreground="#FFEF4444" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="TOTAL CREDITED (PAID)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedCredited, StringFormat='₹{0:N0}'}" Foreground="#FF22C55E" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="OUTSTANDING BALANCE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SelectedCustomer.FormattedBalance}" Foreground="#FFEF4444" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- transaction log header -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Text="Transaction Log" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="DATE &amp; TIME" Style="{StaticResource ColHead}"/>
                                <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource ColHead}"/>
                                <TextBlock Grid.Column="2" Text="DESCRIPTION / NOTE" Style="{StaticResource ColHead}"/>
                                <TextBlock Grid.Column="3" Text="AMOUNT" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="ACTIONS" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>

                        <!-- transaction rows -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CustomerEntries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="4,11" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="80"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding DateShort}" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        BorderThickness="1" BorderBrush="{Binding Type, Converter={StaticResource LedgerTypeToBrush}}">
                                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{Binding Type, Converter={StaticResource LedgerTypeToBrush}}" FontSize="10" FontWeight="Bold"/>
                                                </Border>
                                                <TextBlock Grid.Column="2" Text="{Binding Description}" Foreground="White" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding SignedAmountText}" Foreground="{Binding Type, Converter={StaticResource LedgerTypeToBrush}}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource MiniBtn}" Content="✎" Click="EditEntry_Click" ToolTip="Edit"/>
                                                    <Button Style="{StaticResource MiniBtn}" Content="🗑" Foreground="#FFEF4444" Click="DeleteEntry_Click" ToolTip="Delete"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- delete account -->
                        <Button Grid.Row="4" Content="DELETE CUSTOMER ACCOUNT" Click="DeleteCustomer_Click" HorizontalAlignment="Right" Margin="0,12,0,0"
                                Height="38" Padding="16,0" Cursor="Hand" Background="{StaticResource CardBg}" Foreground="#FFEF4444" FontWeight="Bold" FontSize="11.5" BorderThickness="1" BorderBrush="#40EF4444"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
