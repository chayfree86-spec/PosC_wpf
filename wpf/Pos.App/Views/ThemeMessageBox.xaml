<Window x:Class="Pos.App.Views.ThemeMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message" Height="180" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PanelBg}" WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1.5">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtIcon" Text="ℹ" FontSize="18" Margin="0,0,8,0" Foreground="{StaticResource BlueLink}"/>
                    <TextBlock x:Name="TxtTitle" Text="NOTIFICATION" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
                <Button Click="Close_Click" Style="{StaticResource Stepper}" Content="✕" Width="26" Height="26"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Message Text -->
            <TextBlock x:Name="TxtMessage" Grid.Row="1" Text="Message goes here." Foreground="White" FontSize="14" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Left" LineHeight="20"/>

            <!-- Action -->
            <Button Grid.Row="2" Content="OK" Click="Confirm_Click" Height="36" Width="100" HorizontalAlignment="Right"
                    Background="{StaticResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="12">
                <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>
