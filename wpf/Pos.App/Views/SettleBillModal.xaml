<Window x:Class="Pos.App.Views.SettleBillModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settle Bill" Height="520" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBg}" WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💳" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="SETTLE BILL (भुगतान करें)" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
                <Button Click="Close_Click" Style="{StaticResource Stepper}" Content="✕" Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Payment Mode Tabs -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCash" Grid.Column="0" Content="CASH" Click="Mode_Click" Tag="cash" Margin="0,0,3,0"/>
                <Button x:Name="BtnUpi" Grid.Column="1" Content="UPI / QR" Click="Mode_Click" Tag="upi" Margin="3,0,3,0"/>
                <Button x:Name="BtnCard" Grid.Column="2" Content="CARD" Click="Mode_Click" Tag="card" Margin="3,0,3,0"/>
                <Button x:Name="BtnKhata" Grid.Column="3" Content="KHATA" Click="Mode_Click" Tag="credit" Margin="3,0,0,0"/>
            </Grid>

            <!-- Main Content Area -->
            <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="12" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="16">
                <StackPanel VerticalAlignment="Center">
                    <!-- Grand Total Summary -->
                    <Grid Margin="0,0,0,14">
                        <TextBlock Text="NET AMOUNT TO PAY:" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtNetTotal" Text="₹ 0" Foreground="{DynamicResource Accent}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,0,0,14"/>

                    <!-- Cash Calculation Container (Visible for Cash mode) -->
                    <StackPanel x:Name="CashPanel">
                        <TextBlock Text="RECEIVED CASH (प्राप्त राशि):" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Background="{DynamicResource WindowBg}" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Padding="8,4" Margin="0,0,0,10">
                            <Grid>
                                <TextBlock Text="₹" Foreground="{DynamicResource TextMuted}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtReceived" TextChanged="TxtReceived_TextChanged" KeyDown="TxtReceived_KeyDown"
                                         PreviewTextInput="TxtReceived_PreviewTextInput"
                                         Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold" Margin="20,0,0,0"
                                         Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource Accent}"/>
                            </Grid>
                        </Border>

                        <!-- Quick Cash Shortcut Pills -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Exact" Click="QuickAmount_Click" Tag="exact" Margin="0,0,2,0" Height="28" FontSize="11"/>
                            <Button Grid.Column="1" Content="+₹100" Click="QuickAmount_Click" Tag="100" Margin="2,0,2,0" Height="28" FontSize="11"/>
                            <Button Grid.Column="2" Content="+₹200" Click="QuickAmount_Click" Tag="200" Margin="2,0,2,0" Height="28" FontSize="11"/>
                            <Button Grid.Column="3" Content="+₹500" Click="QuickAmount_Click" Tag="500" Margin="2,0,0,0" Height="28" FontSize="11"/>
                        </Grid>

                        <!-- Change Due -->
                        <Border Background="{DynamicResource WindowBg}" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <TextBlock Text="CHANGE DUE (वापस देना है):" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtChangeDue" Text="₹ 0" Foreground="{DynamicResource Green}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Non-Cash Info Label -->
                    <TextBlock x:Name="NonCashInfo" Text="Proceeding with Digital / Account Settlement."
                               Foreground="{DynamicResource BlueLink}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                               Margin="0,20,0,20" Visibility="Collapsed"/>

                </StackPanel>
            </Border>

            <!-- Bottom Action Buttons -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="CANCEL [Esc]" Click="Close_Click" Height="44" Margin="0,0,8,0"
                        Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextMuted}" FontWeight="Bold" FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnSettleConfirm" Grid.Column="1" Click="Settle_Click" Height="44"
                        Background="{DynamicResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="SETTLE &amp; PRINT BILL [Enter]" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
