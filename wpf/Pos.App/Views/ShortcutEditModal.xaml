<Window x:Class="Pos.App.Views.ShortcutEditModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Customize Key" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">
    <Border Background="{StaticResource PanelBg}" CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Customize Key" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,16"/>

            <Border Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Current Key:" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource CardBg2}" CornerRadius="5" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8,3" HorizontalAlignment="Right">
                            <TextBlock x:Name="CurrentKeyText" Text="None" Foreground="{StaticResource TextPrimary}" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                        </Border>
                    </Grid>
                    <Grid>
                        <TextBlock Text="New Assigned Key:" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="PendingKeyBadge" Background="{StaticResource AccentGrad}" CornerRadius="5" Padding="8,3" HorizontalAlignment="Right" Visibility="Collapsed">
                            <TextBlock x:Name="PendingKeyText" Text="" Foreground="White" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                        </Border>
                        <TextBlock x:Name="NonePendingText" Text="None selected yet" Foreground="{StaticResource TextFaint}" FontSize="11" FontStyle="Italic" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="Niche box par click karein aur keyboard se key press karein." Foreground="{StaticResource TextMuted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340"/>
                <TextBlock Text="(Valid: F1-F12, combos like Ctrl+A, or Escape/Tab/Insert/Space/Backspace/Delete/Enter)" Foreground="{StaticResource TextFaint}" FontSize="9" FontFamily="Consolas" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" Margin="0,4,0,0"/>
            </StackPanel>

            <Border x:Name="CaptureBox" Background="{StaticResource CardBg2}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="2" Margin="0,10,0,0"
                    Padding="10,20" Cursor="Hand" Focusable="True" PreviewKeyDown="CaptureBox_PreviewKeyDown" MouseLeftButtonDown="CaptureBox_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="CaptureHintText" Text="Click here and press key..." Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Listening for key events..." Foreground="{StaticResource TextFaint}" FontSize="10" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border x:Name="ErrorBox" Background="#1AEF4444" BorderBrush="#FFEF4444" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="#FFEF4444" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42" Click="Cancel_Click" Cursor="Hand"
                        Background="{StaticResource CardBg}" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="SaveKeyBtn" Grid.Column="2" Content="Save Key" Height="42" Click="Save_Click" Cursor="Hand" IsEnabled="False"
                        Background="{StaticResource Accent}" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
