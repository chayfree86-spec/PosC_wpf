<Window x:Class="Pos.App.Views.SaveNoteModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Save Note" Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource CardBg2}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1.5" CornerRadius="16" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentFaint}" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="NotebookEditOutline" Width="20" Height="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHeaderTitle" Text="Save Order to Note" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtHeaderSubtitle" Text="Save quick order for later editing or table transfer" Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Click="BtnClose_Click" Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextMuted}"/>
                </Button>
            </Grid>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,2,0,14">
                <!-- Customer Name -->
                <TextBlock Text="CUSTOMER NAME (OPTIONAL)" Foreground="{DynamicResource TextFaint}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1.2" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock x:Name="PlaceholderName" Text="e.g. Rahul Sharma" Foreground="{DynamicResource TextFaint}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtName" TextChanged="TxtName_TextChanged" KeyDown="TxtName_KeyDown" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Customer Mobile -->
                <TextBlock Text="MOBILE NUMBER (OPTIONAL)" Foreground="{DynamicResource TextFaint}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1.2" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock x:Name="PlaceholderMobile" Text="e.g. 9876543210" Foreground="{DynamicResource TextFaint}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtMobile" TextChanged="TxtMobile_TextChanged" KeyDown="TxtMobile_KeyDown" PreviewTextInput="TxtMobile_PreviewTextInput" MaxLength="10" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </Border>

                <!-- Serving Time -->
                <TextBlock Text="SERVING / TARGET TIME" Foreground="{DynamicResource TextFaint}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1.2" CornerRadius="8" Padding="12,9">
                    <Grid>
                        <TextBlock x:Name="PlaceholderTime" Text="e.g. 08:30 PM" Foreground="{DynamicResource TextFaint}" FontSize="12.5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TxtTime" TextChanged="TxtTime_TextChanged" KeyDown="TxtTime_KeyDown" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" Background="Transparent" BorderThickness="0"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Footer Buttons -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.3*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Click="BtnCancel_Click" Height="42">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="10" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                                            <TextBlock Text="CANCEL" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource TextMuted}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="2" Click="BtnSave_Click" Height="42">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="10" Background="{DynamicResource AccentGrad}" RenderTransformOrigin="0.5,0.5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Opacity" Value="0.92"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="b" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon x:Name="IconSubmit" Kind="ContentSaveOutline" Width="16" Height="16" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSubmitButton" Text="SAVE TO NOTE" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
