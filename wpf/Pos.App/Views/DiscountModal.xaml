<Window x:Class="Pos.App.Views.DiscountModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Discount" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        FontFamily="{StaticResource AppFont}">
    <Border Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1.5"
            CornerRadius="14" Padding="20">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="%" Foreground="{DynamicResource AccentText}" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                <TextBlock Text="BILL DISCOUNT (छूट)" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold"/>
            </StackPanel>

            <TextBlock Text="TYPE" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPercent" Grid.Column="0" Content="PERCENT (%)" Click="Type_Click" Tag="percentage"
                        Style="{StaticResource ActionBtn}" Height="38" FontSize="12"/>
                <Button x:Name="BtnFlat" Grid.Column="2" Content="FLAT (₹)" Click="Type_Click" Tag="flat"
                        Style="{StaticResource ActionBtn}" Height="38" FontSize="12"/>
            </Grid>

            <TextBlock x:Name="TxtValueLabel" Text="DISCOUNT %" Foreground="{StaticResource TextFaint}"
                       FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
            <Border Background="{StaticResource CardBg2}" BorderBrush="{StaticResource Border}" BorderThickness="1.5"
                    CornerRadius="10" Padding="14,0" Height="46" Margin="0,0,0,14">
                <TextBox x:Name="TxtValue" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="Bold"
                         VerticalContentAlignment="Center" VerticalAlignment="Center"
                         PreviewTextInput="TxtValue_PreviewTextInput" TextChanged="TxtValue_TextChanged"
                         KeyDown="TxtValue_KeyDown"/>
            </Border>

            <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="SUBTOTAL" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtSubtotal" Foreground="{StaticResource TextPrimary}" FontSize="13"
                                   FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="DISCOUNT" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtDiscount" Foreground="{StaticResource ErrorRed}" FontSize="13"
                                   FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Border Grid.Row="2" Height="1" Background="{StaticResource BorderSoft}" Margin="0,8"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <TextBlock Text="NET PAYABLE" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtNet" Foreground="{DynamicResource AccentText}" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="REMOVE" Click="Remove_Click" Style="{StaticResource ActionBtn}"
                            Height="44" FontSize="11" Width="90" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="CANCEL [Esc]" Click="Cancel_Click" Style="{StaticResource ActionBtn}"
                            Height="44" FontSize="12"/>
                    <Button Grid.Column="3" Content="APPLY [Enter]" Click="Apply_Click" Style="{StaticResource ActionBtn}"
                            Height="44" FontSize="12" Background="{DynamicResource GreenBg}"
                            BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource AccentText}"/>
                </Grid>
            </Grid>
        </StackPanel>
    </Border>
</Window>
