<Window x:Class="Pos.App.Views.SavedNotesModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Saved Order Notes" Height="580" Width="680"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" CornerRadius="16" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentFaint}" Margin="0,0,12,0">
                        <materialDesign:PackIcon Kind="NotebookEditOutline" Width="22" Height="22" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Saved Order Notes" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="Bold"/>
                            <Border x:Name="BadgeCount" Background="{DynamicResource AccentGrad}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtNotesCount" Text="0" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="View, edit, delete, or transfer quick order notes to tables" Foreground="{DynamicResource TextFaint}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Click="BtnClose_Click" Style="{StaticResource LinkBtn}" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4">
                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource TextMuted}"/>
                </Button>
            </Grid>

            <!-- Notes List or Empty State -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <!-- Empty State -->
                <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="NotebookEditOutline" Width="48" Height="48" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="No Saved Order Notes" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Save quick orders using the NOTE button in Quick Bill mode" Foreground="{DynamicResource TextFaint}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- List of Saved Notes -->
                <ScrollViewer x:Name="NotesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="LstNotes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1.2" CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Info: Customer & Time -->
                                        <Grid Grid.Row="0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="AccountOutline" Width="16" Height="16" Foreground="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CustomerName}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CustomerMobile, StringFormat=' ({0})'}" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <materialDesign:PackIcon Kind="ClockOutline" Width="14" Height="14" Foreground="{DynamicResource BlueLink}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding TargetTime, StringFormat='Serving: {0}'}" Foreground="{DynamicResource BlueLink}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SavedTime, StringFormat='Saved: {0}'}" Foreground="{DynamicResource TextFaint}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Detailed Item List -->
                                        <Border Grid.Row="1" Background="{DynamicResource CardBg2}" CornerRadius="8" Padding="12,10" Margin="0,10,0,12">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding ItemsList}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold"/>
                                                                    <TextBlock Text=" (PARCEL)" Foreground="#EAB308" FontSize="10" FontWeight="Bold" Visibility="{Binding IsParcel, Converter={StaticResource BoolToVis}}" Margin="4,0,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Text="{Binding Qty, StringFormat='{}{0} × '}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,2,0"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat='₹{0:0.##}'}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat='₹{0:0.##}'}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,8"/>

                                                <!-- Summary Row -->
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="TOTAL ITEMS: " Foreground="{DynamicResource TextFaint}" FontSize="10" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding TotalQty, StringFormat='{}{0}'}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="GRAND TOTAL: " Foreground="{DynamicResource TextFaint}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding GrandTotal, StringFormat='₹{0:0.##}'}" Foreground="{DynamicResource Accent}" FontSize="15" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Action Buttons -->
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Edit Button -->
                                            <Button Grid.Column="0" Click="BtnEdit_Click" Tag="{Binding}" Height="34">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="8" Background="{DynamicResource CardBg2}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Foreground="{DynamicResource TextPrimary}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="EDIT" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentFaint}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Transfer to Table Button -->
                                            <Button Grid.Column="2" Click="BtnTransfer_Click" Tag="{Binding}" Height="34">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="8" Background="{DynamicResource CardBg2}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="14" Height="14" Foreground="{DynamicResource BlueLink}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="TRANSFER TO TABLE" Foreground="{DynamicResource BlueLink}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BlueLink}"/>
                                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBg}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>

                                            <!-- Delete Button -->
                                            <Button Grid.Column="4" Click="BtnDelete_Click" Tag="{Binding}" Height="34">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="8" Background="{DynamicResource CardBg2}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#EF4444" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="DELETE" Foreground="#EF4444" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="BorderBrush" Value="#EF4444"/>
                                                                            <Setter TargetName="b" Property="Background" Value="#1AEF4444"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Footer Close Button -->
            <Grid Grid.Row="2">
                <Button Click="BtnClose_Click" Height="40" Width="120" HorizontalAlignment="Right">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" CornerRadius="8" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1.2">
                                            <TextBlock Text="CLOSE" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBg2}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
