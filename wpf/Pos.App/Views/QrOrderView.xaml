<UserControl x:Class="Pos.App.Views.QrOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBg}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QR Orders" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Live orders placed by customers via table QR code" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Background="{DynamicResource CardBg}" CornerRadius="8" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10,7" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="LIVE" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Button Content="⟳  REFRESH" Command="{Binding RefreshCommand}" Height="38" Padding="16,0" Cursor="Hand"
                        Background="{DynamicResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <!-- Board -->
        <Border Grid.Row="1" Background="{DynamicResource PanelBg}" CornerRadius="14" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <Grid>
                <!-- empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding PendingCount, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                    <Border Width="72" Height="72" CornerRadius="18" Background="{DynamicResource AccentFaint}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No pending QR orders" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock Text="Orders customers place by scanning the table QR code appear here for you to accept." Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextFaint}" FontSize="11" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- orders board -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16"
                              Visibility="{Binding PendingCount, Converter={StaticResource CountToVis}}">
                    <ItemsControl ItemsSource="{Binding PendingOrders}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="290" Margin="0,0,14,14" Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1.5" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <!-- table + status -->
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TableText}" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding CustomerText}" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                                           Visibility="{Binding CustomerText, Converter={StaticResource StringToVis}}"/>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="6" Padding="7,2"
                                                    Background="{DynamicResource AccentFaint}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentText}" FontSize="9.5" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,10"/>

                                        <!-- items -->
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding QtyText}" Foreground="{DynamicResource AccentText}" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="0,6,0,10"/>

                                        <!-- total + time -->
                                        <Grid Margin="0,0,0,12">
                                            <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextFaint}" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TotalText}" Foreground="{DynamicResource Accent}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- Already taken: the board keeps showing accepted orders,
                                             so the buttons go away once it is on the table. Pressing
                                             Accept twice would add its items to the table twice. -->
                                        <Border Background="{DynamicResource AccentFaint}" BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                CornerRadius="8" Padding="10,7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPending}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="✓  Table par daal diya gaya" Foreground="{DynamicResource AccentText}"
                                                       FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        </Border>

                                        <!-- actions -->
                                        <Grid Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="REJECT" Height="36" Cursor="Hand" FontWeight="Bold" FontSize="11"
                                                    Background="{DynamicResource CardBg2}" Foreground="#EF4444" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                                                    Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Grid.Column="2" Content="ACCEPT → TABLE" Height="36" Cursor="Hand" FontWeight="Bold" FontSize="11"
                                                    Background="{DynamicResource AccentGrad}" Foreground="White" BorderThickness="0"
                                                    Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
