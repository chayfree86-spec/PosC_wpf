<Window x:Class="Pos.App.Views.ExtraItemModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extra Charge" Height="360" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PanelBg}" WindowStyle="None" AllowsTransparency="True">
    <Border CornerRadius="16" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource Border}" BorderThickness="1.5">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⊕" FontSize="18" Margin="0,0,8,0" Foreground="{DynamicResource BlueLink}"/>
                    <TextBlock Text="EXTRA ITEM / CHARGE" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="Bold"/>
                </StackPanel>
                <Button Click="Close_Click" Style="{StaticResource Stepper}" Content="✕" Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Form -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <TextBlock Text="AMOUNT (राशि ₹):" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="{StaticResource WindowBg}" CornerRadius="8" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" Padding="8,4" Margin="0,0,0,14">
                    <Grid>
                        <TextBlock Text="₹" Foreground="{StaticResource TextMuted}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtAmount" Foreground="White" FontSize="18" FontWeight="Bold" Margin="20,0,0,0"
                                 Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource Accent}" KeyDown="Txt_KeyDown"/>
                    </Grid>
                </Border>

                <TextBlock Text="REMARKS / INSTRUCTION (विवरण):" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="{StaticResource WindowBg}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="8,4">
                    <TextBox x:Name="TxtRemarks" Foreground="White" FontSize="14"
                             Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource Accent}" KeyDown="Txt_KeyDown"/>
                </Border>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="CANCEL" Click="Close_Click" Height="42" Margin="0,0,8,0"
                        Background="{StaticResource CardBg}" Foreground="{StaticResource TextMuted}" FontWeight="Bold" FontSize="12">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                    </Button.Resources>
                </Button>

                <Button Grid.Column="1" Content="ADD TO CART" Click="Add_Click" Height="42"
                        Background="{DynamicResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="13">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
