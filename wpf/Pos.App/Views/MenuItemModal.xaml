<Window x:Class="Pos.App.Views.MenuItemModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Menu Item" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <Style x:Key="LangToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentGrad}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SuggestionBtn" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource PanelBg}" CornerRadius="14" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="22">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <TextBlock x:Name="TitleText" Text="Create Menu Item" Foreground="White" FontSize="17" FontWeight="Bold"/>
                <Button Content="✕" Width="26" Height="26" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMuted}" Click="Cancel_Click" Cursor="Hand"/>
            </Grid>

            <!-- Category + Sub Category -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CATEGORY *" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoryCombo" FontSize="13" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CategoryCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SUB CATEGORY" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="SubCategoryCombo" FontSize="13" Height="34" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>
            </Grid>

            <!-- Item name label + Hindi/English toggle -->
            <Grid Margin="0,0,0,4">
                <TextBlock Text="ITEM NAME *" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="{StaticResource CardBg2}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="2" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="HindiToggle" Content="HINDI" IsChecked="True" Style="{StaticResource LangToggle}" Click="HindiToggle_Click"/>
                        <ToggleButton x:Name="EnglishToggle" Content="ENGLISH" Style="{StaticResource LangToggle}" Click="EnglishToggle_Click" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Border Background="{StaticResource WindowBg}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,7">
                    <TextBox x:Name="NameBox" Foreground="White" FontSize="14" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource Accent}"
                             TextChanged="NameBox_TextChanged" PreviewKeyDown="NameBox_PreviewKeyDown"/>
                </Border>
                <TextBlock x:Name="NamePlaceholder" Text="Type in English for Hindi" Foreground="{StaticResource TextFaint}" FontSize="14"
                           Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <!-- Hindi transliteration suggestions -->
            <Border x:Name="SuggestionsPanel" Background="{StaticResource CardBg2}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="HINDI TRANSLITERATION" Foreground="{StaticResource TextFaint}" FontSize="9" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ItemsControl x:Name="SuggestionsList">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Style="{StaticResource SuggestionBtn}" Click="Suggestion_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoSuggestionsText" Text="Type to see suggestions..." Foreground="{StaticResource TextFaint}" FontSize="11" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Price + Code -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ITEM PRICE (₹) *" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource WindowBg}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,7">
                        <TextBox x:Name="PriceBox" Foreground="White" FontSize="14" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="ITEM CODE" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource WindowBg}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,7">
                        <TextBox x:Name="CodeBox" Foreground="White" FontSize="14" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Last added item confirmation (add mode, shown after each save so entry can continue) -->
            <Border x:Name="LastAddedPanel" Background="{StaticResource AccentFaint}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                    CornerRadius="8" Padding="12,9" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="LAST ADDED ITEM" Foreground="{StaticResource Accent}" FontSize="9" FontWeight="Bold" Margin="0,0,0,4"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="LastAddedName" Foreground="White" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="LastAddedCode" Foreground="{StaticResource TextFaint}" FontSize="10" FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="LastAddedPrice" Foreground="White" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Height="42" Click="Cancel_Click" Cursor="Hand"
                        Background="{StaticResource CardBg}" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
                <Button Grid.Column="2" x:Name="SaveButton" Content="Save Menu Item" Height="42" Click="Save_Click" Cursor="Hand"
                        Background="{StaticResource Accent}" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
