<UserControl x:Class="Pos.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBg}">
    <UserControl.Resources>
        <!-- date-range chip -->
        <Style x:Key="RangeBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sales Reports" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="VIEW &amp; ANALYZE SALES" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="38" Padding="18,0" Cursor="Hand"
                    Background="{StaticResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="12"
                    Command="{Binding ExportCsvCommand}" Content="⬇  EXPORT CSV"/>
        </Grid>

        <!-- Date range selector -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Today" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="today">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="today"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Yesterday" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="yesterday">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="yesterday"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Last 7 Days" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="week">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="week"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Last 30 Days" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="month">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="month"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Custom" Command="{Binding SetRangeCommand}" CommandParameter="custom">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="custom"><Setter Property="Foreground" Value="{StaticResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Period:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PeriodDisplay}" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- custom date pickers -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding IsCustomRange, Converter={StaticResource CountToVis}}">
                    <TextBlock Text="From:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding CustomStart, Mode=TwoWay}" Width="150" Margin="0,0,16,0"/>
                    <TextBlock Text="To:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding CustomEnd, Mode=TwoWay}" Width="150" Margin="0,0,16,0"/>
                    <Button Content="Apply" Height="34" Padding="18,0" Cursor="Hand" Command="{Binding ApplyCustomCommand}"
                            Background="{StaticResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Summary cards -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Revenue" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalRevenue}" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="46" Height="46" CornerRadius="12" Background="#1A10B981" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Bills" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalBills}" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource AccentFaint}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Discounts Given" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalDiscounts}" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="46" Height="46" CornerRadius="12" Background="#1AEF4444" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="#FFEF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Order Log -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header + search -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{Binding OrderCount, StringFormat='Order Log ({0})'}" Foreground="White" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Width="320" HorizontalAlignment="Right" Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12,7">
                        <Grid>
                            <TextBlock Text="🔍  सर्च करें (Bill#, Table, Amt, Name...)" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding SearchTerm, Converter={StaticResource StringToVis}}"/>
                            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="13" Background="Transparent" BorderThickness="0" CaretBrush="{StaticResource Accent}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- column headers -->
                <Grid Grid.Row="1" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="BILL #" Style="{StaticResource ColHead}"/>
                    <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource ColHead}"/>
                    <TextBlock Grid.Column="2" Text="TABLE" Style="{StaticResource ColHead}"/>
                    <TextBlock Grid.Column="3" Text="TOTAL" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="ACTION" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                </Grid>

                <!-- rows -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Orders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,10" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding BillNoText}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TableText}" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding TotalText}" Foreground="{StaticResource Accent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <Button Grid.Column="4" Content="View" Click="ViewBill_Click" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Height="30" Padding="14,0" Background="{StaticResource CardBg2}" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Border}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- pagination -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <TextBlock Text="{Binding ExportMessage}" Foreground="{StaticResource Accent}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" Height="32" Padding="14,0" Cursor="Hand"
                                Background="{StaticResource CardBg2}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Border}"/>
                        <TextBlock Text="{Binding PageInfo}" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                        <Button Content="Next ›" Command="{Binding NextPageCommand}" Height="32" Padding="14,0" Cursor="Hand"
                                Background="{StaticResource CardBg2}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Border}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
