<UserControl x:Class="Pos.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource WindowBg}">
    <UserControl.Resources>
        <!-- date-range chip -->
        <Style x:Key="RangeBtn" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="9" Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <!-- Tab pill for switching Order Log / Category Items -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sales Reports" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="VIEW &amp; ANALYZE SALES" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Height="38" Padding="18,0" Cursor="Hand"
                    Background="{DynamicResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="12"
                    Command="{Binding ExportCsvCommand}" Content="⬇  EXPORT CSV"/>
        </Grid>

        <!-- Date range selector -->
        <Border Grid.Row="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
            <StackPanel>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Today" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="today">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="today"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Yesterday" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="yesterday">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="yesterday"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Last 7 Days" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="week">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="week"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Last 30 Days" Margin="0,0,8,0" Command="{Binding SetRangeCommand}" CommandParameter="month">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="month"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <Button Content="Custom" Command="{Binding SetRangeCommand}" CommandParameter="custom">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RangeBtn}">
                                <Style.Triggers><DataTrigger Binding="{Binding RangeType}" Value="custom"><Setter Property="Foreground" Value="{DynamicResource Accent}"/></DataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Counter filter. Opens on the signed-in business's own day; "All"
                             widens it to every brand on the till, combined. Drives the summary
                             cards as well as the log below, so both always answer the same
                             question. -->
                        <TextBlock Text="Counter Name:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <!-- ItemTemplate rather than DisplayMemberPath: the app's dark ComboBox
                             template shows the closed box through SelectionBoxItemTemplate, which
                             follows ItemTemplate. With only DisplayMemberPath set it stays null
                             and the box falls back to ToString() — the class name. -->
                        <ComboBox ItemsSource="{Binding Counters}" SelectedItem="{Binding SelectedCounter, Mode=TwoWay}"
                                  Width="180" Height="34" FontSize="13" Margin="0,0,20,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Period:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding PeriodDisplay}" Foreground="{DynamicResource Accent}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- custom date pickers -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" Visibility="{Binding IsCustomRange, Converter={StaticResource CountToVis}}">
                    <TextBlock Text="From:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding CustomStart, Mode=TwoWay}" Width="150" Margin="0,0,16,0"/>
                    <TextBlock Text="To:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding CustomEnd, Mode=TwoWay}" Width="150" Margin="0,0,16,0"/>
                    <Button Content="Apply" Height="34" Padding="18,0" Cursor="Hand" Command="{Binding ApplyCustomCommand}"
                            Background="{DynamicResource AccentGrad}" Foreground="White" FontWeight="Bold" FontSize="12" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Summary cards -->
        <Grid Grid.Row="2" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Revenue" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalRevenue}" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="46" Height="46" CornerRadius="12" Background="#1A10B981" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#FF10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Bills" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalBills}" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource AccentFaint}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Total Discounts Given" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TotalDiscounts}" Foreground="White" FontSize="24" FontWeight="Black" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Width="46" Height="46" CornerRadius="12" Background="#1AEF4444" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="%" FontSize="20" FontWeight="Bold" Foreground="#FFEF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Order Log -->
        <Border Grid.Row="3" Background="{StaticResource CardBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- tab strip + search -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📋  Order Log" Command="{Binding SelectOrderLogCommand}" Margin="0,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowOrderLog}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFaint}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="🍽  Category Items" Command="{Binding SelectCategoryViewCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource TabBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowCategoryView}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentFaint}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <!-- search (Order Log only) -->
                    <Border Width="320" HorizontalAlignment="Right" Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12,7"
                            Visibility="{Binding ShowOrderLog, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock Text="🔍  सर्च करें (Bill#, Table, Amt, Name...)" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"
                                       Visibility="{Binding SearchTerm, Converter={StaticResource StringToVis}}"/>
                            <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="13" Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource Accent}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========================= ORDER LOG PANEL ========================= -->
                <Grid Grid.Row="1" Visibility="{Binding ShowOrderLog, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- column headers (Staff column removed) -->
                    <Grid Grid.Row="0" Margin="4,0,4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BILL #" Style="{StaticResource ColHead}"/>
                        <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource ColHead}"/>
                        <TextBlock Grid.Column="2" Text="TABLE" Style="{StaticResource ColHead}"/>
                        <TextBlock Grid.Column="3" Text="TOTAL" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="ACTION" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- rows -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Orders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,10" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding BillNoText}" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DateText}" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding TableText}" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalText}" Foreground="{DynamicResource Accent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <Button Content="📒 Khata" Click="AddToLedger_Click" Tag="{Binding}" Cursor="Hand"
                                                        Height="30" Padding="12,0" Margin="0,0,8,0" Background="{StaticResource CardBg2}" Foreground="{DynamicResource AccentText}" FontWeight="Bold" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Border}"
                                                        ToolTip="Is bill ko customer ke khaate (udhaar) me daalein"/>
                                                <Button Content="View" Click="ViewBill_Click" Cursor="Hand"
                                                        Height="30" Padding="14,0" Background="{StaticResource CardBg2}" Foreground="{DynamicResource Accent}" FontWeight="Bold" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Border}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- pagination -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="{Binding ExportMessage}" Foreground="{DynamicResource Accent}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="‹ Prev" Command="{Binding PrevPageCommand}" Height="32" Padding="14,0" Cursor="Hand"
                                    Background="{StaticResource CardBg2}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Border}"/>
                            <TextBlock Text="{Binding PageInfo}" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                            <Button Content="Next ›" Command="{Binding NextPageCommand}" Height="32" Padding="14,0" Cursor="Hand"
                                    Background="{StaticResource CardBg2}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" BorderThickness="1" BorderBrush="{StaticResource Border}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ====================== CATEGORY-WISE ITEMS PANEL ====================== -->
                <Grid Grid.Row="1" Visibility="{Binding ShowCategoryView, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- filters: category + sub-category + item search -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Category:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding CategoryFilterOptions}" SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"
                                      Width="170" Height="34" FontSize="13" Margin="0,0,16,0"/>
                            <TextBlock Text="Sub-category:" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding SubCategoryFilterOptions}" SelectedItem="{Binding SelectedSubCategoryFilter, Mode=TwoWay}"
                                      Width="170" Height="34" FontSize="13"/>
                        </StackPanel>
                        <Border Width="280" HorizontalAlignment="Right" Background="{StaticResource WindowBg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12,7">
                            <Grid>
                                <TextBlock Text="🔍  item search karein..." Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center"
                                           Visibility="{Binding CategorySearch, Converter={StaticResource StringToVis}}"/>
                                <TextBox Text="{Binding CategorySearch, UpdateSourceTrigger=PropertyChanged}" Foreground="White" FontSize="13" Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource Accent}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- column headers -->
                    <Grid Grid.Row="1" Margin="16,0,16,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM  (CATEGORY-WISE)" Style="{StaticResource ColHead}"/>
                        <TextBlock Grid.Column="1" Text="QTY SOLD" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="AMOUNT" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- empty state -->
                            <TextBlock Text="Is period me koi item sale nahi mili." Foreground="{StaticResource TextFaint}" FontSize="13"
                                       HorizontalAlignment="Center" Margin="0,40,0,0"
                                       Visibility="{Binding HasNoCategorySales, Converter={StaticResource BoolToVis}}"/>

                            <ItemsControl ItemsSource="{Binding CategorySales}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <!-- category header bar -->
                                            <Border Background="{StaticResource CardBg2}" CornerRadius="8" Padding="12,9" Margin="0,0,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding CategoryName}" Foreground="{DynamicResource AccentText}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding QtyText}" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{DynamicResource Accent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <!-- item rows -->
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,4,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="8,7" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="120"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding QtyText}" Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding AmountText}" Foreground="{StaticResource TextPrimary}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
