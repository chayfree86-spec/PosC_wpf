<Application x:Class="Pos.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pos.App"
             xmlns:conv="clr-namespace:Pos.App.Converters"
             xmlns:helpers="clr-namespace:Pos.App.Helpers">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ===== Palette (dark) ===== -->
            <SolidColorBrush x:Key="WindowBg" Color="#FF0A0A0A"/>
            <SolidColorBrush x:Key="SidebarBg" Color="#FF121212"/>
            <SolidColorBrush x:Key="PanelBg" Color="#FF121212"/>
            <SolidColorBrush x:Key="CardBg" Color="#FF1E1E1E"/>
            <SolidColorBrush x:Key="CardBg2" Color="#FF171717"/>
            <SolidColorBrush x:Key="Border" Color="#FF2D2D2D"/>
            <SolidColorBrush x:Key="BorderSoft" Color="#FF202020"/>
            <SolidColorBrush x:Key="Accent" Color="#FF00704A"/>
            <SolidColorBrush x:Key="AccentDim" Color="#FF005438"/>
            <SolidColorBrush x:Key="AccentFaint" Color="#1A00704A"/>
            <!-- Menu rows sit on PanelBg (#121212); AccentFaint at 10% alpha is invisible
                 there, so the hovered/keyboard-selected row needs its own solid brushes. -->
            <SolidColorBrush x:Key="MenuHighlight" Color="#FF123A26"/>
            <SolidColorBrush x:Key="MenuHighlightDanger" Color="#FF3A1B1B"/>
            <!-- Accent is too dark to read as small text on the dark background; use this for
                 badge/label text that sits on WindowBg/CardBg. -->
            <SolidColorBrush x:Key="AccentText" Color="#FF4ADE80"/>
            <SolidColorBrush x:Key="Green" Color="#FF00704A"/>
            <SolidColorBrush x:Key="GreenBg" Color="#FF123A26"/>
            <SolidColorBrush x:Key="BlueLink" Color="#FF4ADE80"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#FFE6EAF2"/>
            <SolidColorBrush x:Key="TextMuted" Color="#FF9CA3AF"/>
            <SolidColorBrush x:Key="TextFaint" Color="#FF6B7280"/>
            <SolidColorBrush x:Key="ErrorRed" Color="#EF4444"/>
            <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF008A5B" Offset="0"/>
                <GradientStop Color="#FF005E3E" Offset="1"/>
            </LinearGradientBrush>

            <FontFamily x:Key="AppFont">./Fonts/#Baloo 2, Segoe UI, sans-serif</FontFamily>

            <!-- ===== Global Implicit TextBox Style for Theme Selection ===== -->
            <Style TargetType="TextBox">
                <!-- WPF draws a 1px caret (the machine-wide Windows thickness); this paints a
                     4px one instead. Keyed TextBox styles don't inherit implicit styles, so the
                     setter is repeated on those. -->
                <Setter Property="helpers:ThickCaret.Width" Value="4"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="SelectionTextBrush" Value="White"/>
                <!-- Must stay at 1: below 1 WPF falls back to painting a translucent
                     selection rectangle over the text and ignores SelectionTextBrush, which
                     washed selected digits out to the selection colour (the qty box selects
                     its content on focus, so this hid the quantity). -->
                <Setter Property="SelectionOpacity" Value="1"/>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrush"/>
            <conv:StatusToBrushConverter x:Key="StatusToBrushConverter"/>
            <conv:LedgerTypeToBrushConverter x:Key="LedgerTypeToBrush"/>
            <conv:StatusToDotBrushConverter x:Key="StatusToDotBrush"/>
            <conv:StatusToCardBgConverter x:Key="StatusToCardBg"/>
            <conv:StatusToBorderBrushConverter x:Key="StatusToBorderBrush"/>
            <conv:StatusToTimeBrushConverter x:Key="StatusToTimeBrush"/>
            <conv:StatusToTitleForegroundConverter x:Key="StatusToTitleForeground"/>
            <conv:CurrencyConverter x:Key="Money"/>
            <conv:CountToVisibilityConverter x:Key="CountToVis"/>
            <conv:StringEqualsToVisibilityConverter x:Key="ModeToVis"/>
            <conv:StringIsNullOrEmptyToVisibilityConverter x:Key="StringToVis"/>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>

            <!-- ===== Sidebar nav item ===== -->
            <Style x:Key="NavItem" TargetType="Button">
                <Setter Property="Height" Value="46"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}" Padding="14,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentFaint}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="NavItemActive" TargetType="Button" BasedOn="{StaticResource NavItem}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="10" Background="{DynamicResource AccentGrad}" Padding="14,0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Search box ===== -->
            <!-- BasedOn the implicit style: keyed styles don't inherit it, so without this
                 the search box fell back to the Windows-blue selection. -->
            <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="helpers:ThickCaret.Width" Value="4"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="b" CornerRadius="12" Background="{DynamicResource CardBg2}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1.5" Padding="16,0">
                                <Grid>
                                    <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource TextFaint}"
                                               VerticalAlignment="Center" FontSize="14" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Inline editable cart cell (qty / price) =====
                 These fields select their whole content on focus so the next keystroke
                 replaces it. A selection highlight only covers the glyphs, so a single
                 selected digit came out as a thin sliver of colour with the number lost
                 inside it. The field itself carries the highlight instead, which gives the
                 number room to read, and the selection brush stays out of the way. -->
            <Style x:Key="CellEditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CaretBrush" Value="White"/>
                <Setter Property="SelectionBrush" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="6,3">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Template triggers outrank style setters but lose to local
                                     values, so the usages must not set Foreground inline. -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PriceCellEditBox" TargetType="TextBox" BasedOn="{StaticResource CellEditBox}">
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                <Setter Property="FontSize" Value="11.5"/>
            </Style>

            <!-- ===== Area filter chip (ListBoxItem) ===== -->
            <Style x:Key="AreaChip" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,18,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="b" Padding="2,6" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Table card (ListBoxItem) ===== -->
            <Style x:Key="TableCard" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="3"/>
                <Setter Property="Cursor" Value="Hand"/>
                <!-- No fixed size: the AdaptiveUniformGrid stretches each card to fill its cell, so
                     every table fits on screen without scrolling — the card shrinks to whatever the
                     grid needs and its content stays anchored (number top, amount/time bottom). -->
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="MinHeight" Value="66"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="b" CornerRadius="14"
                                    Background="{Binding Status, Converter={StaticResource StatusToCardBg}}"
                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBorderBrush}}"
                                    BorderThickness="1.5" Padding="0">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelectedTableBorder}"/>
                                    <Setter TargetName="b" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Menu item card (Button) ===== -->
            <Style x:Key="MenuCard" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="150"/>
                <Setter Property="Height" Value="92"/>
                <Setter Property="Margin" Value="0,0,12,12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="12" Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1.5" Padding="14,12">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentFaint}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Stepper ===== -->
            <Style x:Key="Stepper" TargetType="Button">
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="8" Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Bottom action button (PRINT KOT / BILL / SETTLE) ===== -->
            <Style x:Key="ActionBtn" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1.5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                        <Setter Property="Background" Value="{DynamicResource AccentFaint}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Dark themed scrollbar ===== -->
            <Style x:Key="SbRepeat" TargetType="RepeatButton">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="4"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SbRepeat}" Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource SbRepeat}" Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                     <Border x:Name="t" CornerRadius="2" Background="#FF303030" Margin="0"/>
                                                     <ControlTemplate.Triggers>
                                                         <Trigger Property="IsMouseOver" Value="True">
                                                             <Setter TargetName="t" Property="Background" Value="#FF454545"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="4"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Grid splitter (resize handle) ===== -->
            <Style TargetType="GridSplitter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="SizeWE"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border Width="3" CornerRadius="2" Background="{DynamicResource BorderSoft}"
                                        HorizontalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="GridSplitter">
                                    <Grid Background="Transparent">
                                        <Border Width="3" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Link-style text button ===== -->
            <!-- Links sit in the normal text colour and light up accent-green on hover, so a
                 row of them reads as text rather than as a wall of green. The foreground is
                 inherited by the content, which is how the icons follow along — usages must
                 not set Foreground inline or the hover can't override it (a local value
                 outranks a template trigger). -->
            <Style x:Key="LinkBtn" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="4,2">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Header Tab Button Style ===== -->
            <Style x:Key="HeaderTabBtn" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentFaint}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Default rounded Button (unstyled buttons) ===== -->
            <Style TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{DynamicResource CardBg}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Dark DatePicker + Calendar ===== -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <Grid><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/></Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkCalendarDayButton" TargetType="CalendarDayButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Border x:Name="b" CornerRadius="6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentFaint}"/></Trigger>
                                <Trigger Property="IsToday" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource TextFaint}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkCalendarButton" TargetType="CalendarButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarButton">
                            <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource AccentFaint}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="DarkCalendarItem" TargetType="CalendarItem">
                <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style x:Key="DarkCalendar" TargetType="Calendar">
                <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource DarkCalendarDayButton}"/>
                <Setter Property="CalendarButtonStyle" Value="{StaticResource DarkCalendarButton}"/>
                <Setter Property="CalendarItemStyle" Value="{StaticResource DarkCalendarItem}"/>
                <!-- enlarge the whole calendar so day cells are easy to click -->
                <Setter Property="LayoutTransform">
                    <Setter.Value><ScaleTransform ScaleX="1.55" ScaleY="1.55"/></Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DatePicker">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="CalendarStyle" Value="{StaticResource DarkCalendar}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource CardBg2}" BorderBrush="{DynamicResource Border}" BorderThickness="1.5">
                                <Grid x:Name="PART_Root">
                                    <!-- Full-area button: click ANYWHERE on the field opens the calendar -->
                                    <Button x:Name="PART_Button" Focusable="False" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Date text + calendar glyph shown on top (non-interactive so clicks reach the button) -->
                                    <Grid IsHitTestVisible="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0" IsHitTestVisible="False" VerticalContentAlignment="Center" Margin="10,0,0,0"
                                                           Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Grid.Column="1" Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Dark ComboBox ===== -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBg2}"/>
                                </Trigger>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource CardBg2}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="tb" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource CardBg2}"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                                <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      Fill="{DynamicResource TextMuted}" Data="M0,0 L4,4 L8,0 Z"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Margin="12,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  IsHitTestVisible="False" TextElement.Foreground="{DynamicResource TextPrimary}"/>
                                <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                    <Border Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            CornerRadius="8" Margin="0,2,0,0" MaxHeight="280"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Dark ContextMenu / MenuItem =====
                 The default templates render a light icon gutter and the Windows accent
                 highlight, which looked out of place against the dark theme. -->
            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="b" CornerRadius="7" Background="Transparent" Padding="10,0" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" ContentSource="Icon" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- IsHighlighted covers both mouse hover and keyboard arrow
                                     navigation, so the active row always reads as selected. -->
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource MenuHighlight}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                </Trigger>
                                <!-- Destructive rows (Tag="danger") keep their red identity
                                     instead of turning green on highlight. -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsHighlighted" Value="True"/>
                                        <Condition Property="Tag" Value="danger"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource MenuHighlightDanger}"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Separator">
                            <Border Height="1" Background="{DynamicResource BorderSoft}" Margin="8,5"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Dark CheckBox ===== -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#FFB8C0D0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="18" Height="18" CornerRadius="5" Background="{DynamicResource CardBg2}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1" VerticalAlignment="Center">
                                    <Path x:Name="tick" Stretch="Uniform" Margin="3" Visibility="Collapsed"
                                          Stroke="White" StrokeThickness="2" Data="M0,3 L2.5,6 L7,0"/>
                                </Border>
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
