<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Pos.Core\Pos.Core.csproj" />
    <ProjectReference Include="..\Pos.Contracts\Pos.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <!-- Installer + auto-update. Version matches the vpk CLI that builds the release. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Keep in step with Pos.Core AppInfo.Version (the value the footer and update check use). -->
    <Version>3.0.1</Version>
    <!-- Custom entry point so Velopack's hook runs before anything else (see Program.cs). -->
    <StartupObject>Pos.App.Program</StartupObject>
    <!-- Application Icon (Light theme as default. Change to app_icon_dark.ico for Dark theme) -->
    <ApplicationIcon>app_icon_light.ico</ApplicationIcon>
  </PropertyGroup>


  <!-- App.xaml as a Page, not the auto-generated entry point, so Program.Main is the real one. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
  </ItemGroup>

  <!-- Point Release builds at the live server. deploy.env is copied into the build/publish
       output as ".env", which the app reads on startup (see DotEnv / SyncCoordinator.ApiUrl).
       Debug builds skip this and keep the local development default, so nothing here disturbs
       day-to-day work on 127.0.0.1. -->
  <Target Name="CopyDeployEnvToOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="deploy.env" DestinationFiles="$(OutDir).env" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDeployEnvToPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="deploy.env" DestinationFiles="$(PublishDir).env" SkipUnchangedFiles="true" />
  </Target>

  <!-- Local .env file copy target for development/debug builds -->
  <Target Name="CopyLocalEnvToOutput" AfterTargets="Build" Condition="Exists('.env')">
    <Copy SourceFiles=".env" DestinationFiles="$(OutDir).env" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <!-- WPF's default is to render text selection through an adorner, which paints the
         highlight *over* the text and ignores SelectionTextBrush — selected text vanishes
         behind the highlight. The qty box selects its content on focus, so the quantity
         was invisible exactly when the user was about to retype it. This switch has to be
         in runtimeconfig: WPF reads it before any of our code runs. -->
    <RuntimeHostConfigurationOption
      Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering"
      Value="false" />
  </ItemGroup>

</Project>
