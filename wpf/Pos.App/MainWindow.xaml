                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="QTY" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding TotalQty}" Foreground="{StaticResource TextPrimary}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,1,0,0"/>
                                </StackPanel>

                                <!-- Divider -->
                                <Border Width="1" Height="26" Background="{StaticResource BorderSoft}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <!-- GRAND TOTAL -->
