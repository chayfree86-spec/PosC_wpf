                                    <TextBlock Text="GRAND TOTAL" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,0,0">
                                        <TextBlock Text="₹" Foreground="{DynamicResource Accent}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:0.##}'}" Foreground="{DynamicResource Accent}" FontSize="21" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

