                                <TextBlock Text="NOTE" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 2. Distinct Totals Card Container -->
                    <Border Background="{StaticResource CardBg2}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1.2"
                            CornerRadius="12" Padding="12,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- % Discount Button -->
                            <Button Grid.Column="0" VerticalAlignment="Center" Click="Discount_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" CornerRadius="8" Background="Transparent"
                                                            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1.2" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="% DISCOUNT" Foreground="{StaticResource TextPrimary}"
                                                                       FontSize="11" FontWeight="Bold"/>
                                                            <TextBlock Foreground="{StaticResource ErrorRed}" FontSize="11" FontWeight="Bold"
                                                                       Margin="6,0,0,0"
                                                                       Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                                                <Run Text="{Binding DiscountLabel, Mode=OneWay}"/><Run Text="  −₹"/><Run Text="{Binding DiscountAmount, Mode=OneWay, StringFormat={}{0:0.##}}"/>
