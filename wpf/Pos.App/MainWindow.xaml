<Window x:Class="Pos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pos.App"
        xmlns:helpers="clr-namespace:Pos.App.Helpers"
        xmlns:views="clr-namespace:Pos.App.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="{Binding ClientName, StringFormat={}{0} POS}" Height="800" Width="1366"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource WindowBg}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource AppFont}"
        Loaded="Window_Loaded" Activated="Window_Activated" KeyDown="Window_KeyDown" Closing="Window_Closing">

    <!-- No hard-coded InputBindings: hotkeys are resolved from Settings → Shortcuts in
         Window_KeyDown so user remaps apply, and so F3/F4/F5 aren't handled twice. -->

    <Window.Resources>
        <!-- Shared across every table card: WPF sets the menu's DataContext from the
             right-clicked card, so the Click handlers still resolve the correct table. -->
        <ContextMenu x:Key="TableContextMenu">
            <MenuItem Header="Change Table" Click="TableContext_ChangeTable_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16" Foreground="{StaticResource TextMuted}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Merge Table" Click="TableContext_MergeTable_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="CallMerge" Width="16" Height="16" Foreground="{StaticResource TextMuted}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Split Table" Click="TableContext_SplitTable_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="CallSplit" Width="16" Height="16" Foreground="{StaticResource TextMuted}"/>
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Settle Bill" Click="TableContext_SettleBill_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="CreditCardOutline" Width="16" Height="16" Foreground="{DynamicResource AccentText}"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Delete Bill" Click="TableContext_DeleteBill_Click" Foreground="{StaticResource ErrorRed}" Tag="danger">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" Foreground="{StaticResource ErrorRed}"/>
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColSidebar" Width="256"/>
            <ColumnDefinition Width="*" MinWidth="420"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="ColOrderPanel" Width="424" MinWidth="360" MaxWidth="720"/>
        </Grid.ColumnDefinitions>

        <!-- ================= SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBg}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,1.5,0">
            <DockPanel x:Name="SidebarDockPanel" Margin="16,20">
                <!-- logo -->
                <Grid x:Name="SidebarHeaderGrid" DockPanel.Dock="Top" Margin="0,0,0,26">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="SidebarLogoContainer" Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="0">
                        <Border Background="{DynamicResource AccentGrad}" CornerRadius="10" Width="40" Height="40">
                            <TextBlock Text="{Binding ClientInitials}" Foreground="White" FontWeight="Bold" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel x:Name="SidebarExpandedHeader" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ClientName}" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Text="POS SYSTEM" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="BtnToggleSidebar" Click="BtnToggleSidebar_Click" Style="{StaticResource LinkBtn}"
                            Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Toggle Sidebar">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource CardBg}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <TextBlock x:Name="TxtSidebarToggleIcon" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                </Grid>

                <!-- bottom cluster -->
                <StackPanel x:Name="SidebarBottomNavPanel" DockPanel.Dock="Bottom">
                    <Button Command="{Binding NavToCommand}" CommandParameter="Ledger" ToolTip="Len-Den">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveScreen}" Value="Ledger">
                                        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="BookOpenOutline" Width="18" Height="18" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Tag="NavText" Text="Len-Den" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavToCommand}" CommandParameter="Settings" ToolTip="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveScreen}" Value="Settings">
                                        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Tag="NavText" Text="Settings" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,14"/>

                    <!-- Who is on the till. The counter changes hands mid-shift, and the
                         logout button below says nothing about whom it is logging out. -->
                    <StackPanel x:Name="SidebarUserRow" Orientation="Horizontal" Margin="4,0,0,12"
                                Visibility="Collapsed">
                        <TextBlock x:Name="SidebarUserText" Tag="NavText" Margin="0"
                                   FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Accent}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid x:Name="SidebarFooterGrid">
                        <Button x:Name="BtnLogout" Click="Logout_Click" ToolTip="Logout"
                                Height="40" Cursor="Hand" BorderThickness="1"
                                BorderBrush="{StaticResource BorderSoft}" Background="Transparent"
                                Foreground="{StaticResource TextMuted}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1FEF4444"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#EF4444"/>
                                            <Setter Property="Foreground" Value="#EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="LogoutVariant" Width="18" Height="18"
                                                         Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="SidebarExpandedFooterText" Text="LOGOUT" Margin="10,0,0,0" FontSize="11" FontWeight="Bold"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- main nav -->
                <StackPanel x:Name="SidebarNavPanel" DockPanel.Dock="Top">
                    <Button Command="{Binding NavToCommand}" CommandParameter="Orders" ToolTip="Orders">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveScreen}" Value="Orders">
                                        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FoodForkDrink" Width="18" Height="18" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Tag="NavText" Text="Orders" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button ToolTip="QR Order" Command="{Binding NavToCommand}" CommandParameter="QR">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveScreen}" Value="QR">
                                        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="QrcodeScan" Width="18" Height="18" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Tag="NavText" Text="QR Order" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button ToolTip="Reports" Command="{Binding NavToCommand}" CommandParameter="Reports">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveScreen}" Value="Reports">
                                        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="18" Height="18" Margin="0,0,12,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center"/>
                            <TextBlock Tag="NavText" Text="Reports" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button ToolTip="Notes" Command="{Binding NavToCommand}" CommandParameter="Notes">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveScreen}" Value="Notes">
                                        <Setter Property="Background" Value="{DynamicResource AccentGrad}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <!-- The icon itself turns green while quick notes are waiting.
                                     It used to carry a blinking badge dot, whose Loaded-triggered
                                     "forever" storyboard ran for the life of the app — visible or
                                     not — and was the single biggest source of idle CPU. -->
                                <materialDesign:PackIcon Kind="NotebookEditOutline" Width="18" Height="18"
                                                         Margin="0,0,12,0" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <!-- In the style, not inline: a local value would outrank
                                                 the trigger below and the green would never show. -->
                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSavedNotes}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <TextBlock Tag="NavText" Text="Notes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= CENTER ================= -->
        <!-- Collapsed while a full-page screen (Settings/Reports/Ledger/QR/Notes) is active so the
             whole Orders visual tree isn't laid out and rendered underneath the overlay. -->
        <Border Grid.Column="1" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource Border}" BorderThickness="1.5"
                CornerRadius="16" Margin="12,12,6,12"
                Visibility="{Binding ActiveScreen, Converter={StaticResource ModeToVis}, ConverterParameter=Orders}">
            <!-- Bottom padding matches the footer row's own top margin (14) so the status
                 bar sits centred in the strip between the grid and the panel edge; at 20 it
                 had more room below than above and read as sitting high. -->
            <Grid Margin="20,20,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header: title + tabs + search -->
                <Grid Grid.Row="0" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Orders" Foreground="{StaticResource TextPrimary}" FontSize="22" FontWeight="Bold"/>
                        <Button Command="{Binding ShowTableViewCommand}" Style="{StaticResource LinkBtn}" Margin="24,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Table" FontSize="15" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CenterMode}" Value="Table">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Height="2.5" Background="{DynamicResource AccentGrad}" Margin="0,4,0,0"
                                        Visibility="{Binding CenterMode, Converter={StaticResource ModeToVis}, ConverterParameter=Table}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ShowMenuViewCommand}" Style="{StaticResource LinkBtn}" Margin="16,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Menu" FontSize="15" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CenterMode}" Value="Menu">
                                                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Border Height="2.5" Background="{DynamicResource AccentGrad}" Margin="0,4,0,0"
                                        Visibility="{Binding CenterMode, Converter={StaticResource ModeToVis}, ConverterParameter=Menu}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBox Grid.Column="1" x:Name="SearchInput" Style="{StaticResource SearchBox}" Tag="Search food item or code..." Height="46"
                             MaxWidth="420" MinWidth="240" Margin="16,0,0,0"
                             HorizontalAlignment="Right" VerticalContentAlignment="Center"
                             PreviewKeyDown="SearchInput_PreviewKeyDown"
                             LostKeyboardFocus="SearchInput_LostKeyboardFocus"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                </Grid>

                <!-- area chips (Table mode) -->
                <Grid Grid.Row="1" Margin="0,0,0,14"
                      Visibility="{Binding CenterMode, Converter={StaticResource ModeToVis}, ConverterParameter=Table}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Name="BtnScrollAreasLeft" Click="BtnScrollAreasLeft_Click" Content="❮" Style="{StaticResource Stepper}" Width="28" Height="28"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>

                    <ListBox Grid.Column="1" Name="AreasListBox" ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource AreaChip}"
                             KeyboardNavigation.DirectionalNavigation="None"
                             PreviewMouseWheel="ListBox_PreviewMouseWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold"/>
                                    <Border Background="{StaticResource CardBg}" CornerRadius="9" Margin="8,0,0,0" Padding="7,1" MinWidth="20">
                                        <TextBlock Text="{Binding Count}" Foreground="{StaticResource TextMuted}" FontSize="11"
                                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Column="2" Name="BtnScrollAreasRight" Click="BtnScrollAreasRight_Click" Content="❯" Style="{StaticResource Stepper}" Width="28" Height="28"
                            Margin="8,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <!-- CATEGORIES bar (Menu mode) -->
                <Border Grid.Row="1" Background="{StaticResource CardBg2}" BorderBrush="{StaticResource BorderSoft}"
                        BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                        Visibility="{Binding CenterMode, Converter={StaticResource ModeToVis}, ConverterParameter=Menu}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="CATEGORIES" Foreground="{StaticResource TextFaint}"
                                   FontSize="10" FontWeight="Bold" Margin="2,0,0,8"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Name="BtnScrollCategoriesLeft" Click="BtnScrollCategoriesLeft_Click" Content="❮" Style="{StaticResource Stepper}" Width="28" Height="28"
                                    Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <ListBox Grid.Column="1" Name="CategoriesListBox" ItemsSource="{Binding CategoryTabs}" SelectedItem="{Binding SelectedCategoryTab}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     KeyboardNavigation.DirectionalNavigation="None"
                                     PreviewMouseWheel="ListBox_PreviewMouseWheel">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Margin" Value="0,0,8,0"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="b" CornerRadius="8" Background="{StaticResource CardBg}"
                                                            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12,7">
                                                        <TextBlock x:Name="t" Text="{Binding DisplayText}" Foreground="{StaticResource TextMuted}"
                                                                   FontSize="12" FontWeight="Bold"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentGrad}"/>
                                                            <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                                                            <Setter TargetName="t" Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>

                            <Button Grid.Column="2" Name="BtnScrollCategoriesRight" Click="BtnScrollCategoriesRight_Click" Content="❯" Style="{StaticResource Stepper}" Width="28" Height="28"
                                    Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- TABLE GRID (Table mode) -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Tables}" SelectedItem="{Binding SelectedTable}"
                         Background="Transparent" BorderThickness="0" Padding="0,0,8,0" ItemContainerStyle="{StaticResource TableCard}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False"
                         HorizontalContentAlignment="Stretch"
                         KeyboardNavigation.DirectionalNavigation="None"
                         PreviewKeyDown="TablesListBox_PreviewKeyDown"
                         ContextMenu="{StaticResource TableContextMenu}"
                         ContextMenuOpening="TablesListBox_ContextMenuOpening"
                         Visibility="{Binding CenterMode, Converter={StaticResource ModeToVis}, ConverterParameter=Table}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- The context menu lives on the ListBox (one instance for all cards)
                                 rather than being rebuilt per card; see TablesListBox_ContextMenuOpening. -->
                            <Border Padding="10,6" HorizontalAlignment="Stretch" Background="Transparent">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Table Number / Name with Status Dot on Right -->
                                    <Grid Grid.Row="0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding TableNumber}" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="12.5" FontWeight="Bold" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        <Ellipse Width="9" Height="9" Fill="{Binding Status, Converter={StaticResource StatusToDotBrush}}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Running Bill Amount & Order Time (if active) -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0">
                                        <!-- Amount in BOLD -->
                                        <TextBlock Text="{Binding Amount, StringFormat='₹{0:0.##}'}"
                                                   Foreground="White" FontSize="15" FontWeight="Bold"
                                                   Visibility="{Binding Amount, Converter={StaticResource CountToVis}}"/>

                                        <!-- Order Elapsed Time in Small Size -->
                                        <TextBlock Text="{Binding FormattedTime}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusToTimeBrush}}" FontSize="10" FontWeight="Normal" Margin="0,1,0,0"
                                                   Visibility="{Binding Amount, Converter={StaticResource CountToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- MENU MODE SPLIT VIEW (Menu Items on Left, Most Selling Items on Right) -->
                <Grid Grid.Row="2" Visibility="{Binding CenterMode, Converter={StaticResource ModeToVis}, ConverterParameter=Menu}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4.2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT COLUMN: MENU ITEMS LIST -->
                    <Border Grid.Column="0" Background="{StaticResource CardBg2}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="12" Padding="12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="MENU ITEMS" Foreground="{StaticResource TextFaint}"
                                       FontSize="10" FontWeight="Bold" Margin="2,0,0,8"/>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleItems}"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                    <!-- The ScrollViewer has to live inside the template. An
                                         ItemsControl wrapped in an outer ScrollViewer is measured
                                         with infinite height, which silently turns virtualization
                                         off and realizes every menu item on each refresh. -->
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer CanContentScroll="True" Focusable="False"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" Margin="0,0,0,6" HorizontalContentAlignment="Stretch">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Background" Value="{StaticResource CardBg}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="b" CornerRadius="10" Background="{TemplateBinding Background}"
                                                                            BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12,10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>

                                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                                                                       FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                                                            <Border Grid.Column="1" Background="{StaticResource CardBg2}" CornerRadius="6"
                                                                                    Padding="8,2" Margin="8,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextMuted}"
                                                                                           FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                            </Border>

                                                                            <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='₹{0:0.##}'}"
                                                                                       Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold"
                                                                                       VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                            <Setter TargetName="b" Property="Background" Value="#1A00704A"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- RIGHT COLUMN: MOST SELLING ITEMS -->
                    <Border Grid.Column="2" Background="{StaticResource CardBg2}" BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock Text="MOST SELLING ITEMS" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right" Background="#26EA580C" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="6" Padding="6,1.5">
                                    <TextBlock Text="popular" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                                           Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"/>
                                <TextBlock Text="No Sales Data Yet" Foreground="{StaticResource TextPrimary}"
                                           FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="Popular items appear here after sales" Foreground="{StaticResource TextFaint}"
                                           FontSize="11.5" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- footer -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="8,3">
                            <TextBlock Text="v2.4.8" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Green}" Margin="12,0,6,0"/>
                        <TextBlock Text="APP UP TO DATE" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>

                        <Border Width="1" Height="14" Background="{StaticResource BorderSoft}" Margin="12,0" VerticalAlignment="Center"/>

                        <!-- Sync ki haalat: hara = sab bheja ja chuka, peela = katar me hai,
                             laal = server se baat nahi ho rahi. Click karne par turant koshish. -->
                        <Button Command="{Binding SyncNowCommand}" Style="{StaticResource LinkBtn}"
                                ToolTip="{Binding SyncTooltip}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource TextFaint}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SyncState}" Value="ok">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentText}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SyncState}" Value="pending">
                                                    <Setter Property="Fill" Value="#FFF59E0B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SyncState}" Value="offline">
                                                    <Setter Property="Fill" Value="{StaticResource ErrorRed}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding SyncText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="CHANGE TABLE" Click="ChangeTable_Click" Style="{StaticResource LinkBtn}"/>
                        <TextBlock Text="|" Foreground="{StaticResource TextFaint}" Margin="8,0" VerticalAlignment="Center"/>
                        <Button Content="MERGE TABLE" Click="MergeTable_Click" Style="{StaticResource LinkBtn}"/>
                        <TextBlock Text="|" Foreground="{StaticResource TextFaint}" Margin="8,0" VerticalAlignment="Center"/>
                        <Button Content="SPLIT TABLE" Click="SplitTable_Click" Style="{StaticResource LinkBtn}"/>
                    </StackPanel>
                </Grid>

                <!-- Search suggestions dropdown.
                     Deliberately an in-window overlay rather than a Popup: a Popup is its own
                     (layered) HWND, and resizing it as the match count changed cost 30-40ms per
                     keystroke, which is what made typing feel laggy. As a Border in this Grid it
                     resizes as ordinary layout. -->
                <Border x:Name="SearchDropdown" Grid.Row="1" Grid.RowSpan="3" Panel.ZIndex="99"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-12,0,0"
                        Visibility="{Binding IsSearchPopupOpen, Converter={StaticResource BoolToVis}}">
                    <Border Width="{Binding ActualWidth, ElementName=SearchInput}" MaxHeight="320"
                            Background="{StaticResource CardBg}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                            CornerRadius="12" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black"/>
                        </Border.Effect>
                        <ListBox x:Name="PopupListBox" ItemsSource="{Binding Suggestions}"
                                 Focusable="False"
                                 SelectedItem="{Binding SelectedMenuItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 MouseLeftButtonUp="PopupListBox_MouseLeftButtonUp">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="b" CornerRadius="8" Padding="12,10" Background="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentDim}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="{StaticResource CardBg2}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="1" Background="{DynamicResource AccentFaint}" CornerRadius="5" Padding="6,2" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Price, StringFormat='₹{0:0.##}'}"
                                                   Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- resize handle for the order panel -->
        <GridSplitter Grid.Column="2" Width="10" VerticalAlignment="Stretch" Margin="0,12"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      DragCompleted="GridSplitter_DragCompleted"
                      Visibility="{Binding ActiveScreen, Converter={StaticResource ModeToVis}, ConverterParameter=Orders}"/>

        <!-- ================= RIGHT: BILL ================= -->
        <Border Grid.Column="3" Background="{StaticResource PanelBg}"
                BorderBrush="{StaticResource Border}" BorderThickness="1.5"
                CornerRadius="16" Margin="6,12,12,12"
                Visibility="{Binding ActiveScreen, Converter={StaticResource ModeToVis}, ConverterParameter=Orders}">
            <Grid Margin="12,12,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- header -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="{Binding BillTitle}" Foreground="{StaticResource TextPrimary}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentFaint}" CornerRadius="8" Padding="8,2" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding DraftLabel}" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>

                <!-- bill mode toggles -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Command="{Binding SetBillModeCommand}" CommandParameter="Quick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BillMode}" Value="Quick">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <!-- GreenBg, not black: pure black punched a hole in the
                                             panel instead of reading as a selected surface. -->
                                        <Setter Property="Background" Value="{DynamicResource GreenBg}"/>
                                        <!-- AccentText, not Accent: the accent green is too dark to
                                             read as a small label/icon on the black selected tab, even
                                             though it looks right as the 1.5px outline. -->
                                        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="LightningBoltOutline" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="QUICK BILL" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Command="{Binding SetBillModeCommand}" CommandParameter="Table">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BillMode}" Value="Table">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <!-- GreenBg, not black: pure black punched a hole in the
                                             panel instead of reading as a selected surface. -->
                                        <Setter Property="Background" Value="{DynamicResource GreenBg}"/>
                                        <!-- AccentText, not Accent: the accent green is too dark to
                                             read as a small label/icon on the black selected tab, even
                                             though it looks right as the 1.5px outline. -->
                                        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="TableChair" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TABLE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="4" Command="{Binding SetBillModeCommand}" CommandParameter="QR">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ActionBtn}">
                                <Setter Property="Height" Value="32"/><Setter Property="FontSize" Value="11"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BillMode}" Value="QR">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                        <!-- GreenBg, not black: pure black punched a hole in the
                                             panel instead of reading as a selected surface. -->
                                        <Setter Property="Background" Value="{DynamicResource GreenBg}"/>
                                        <!-- AccentText, not Accent: the accent green is too dark to
                                             read as a small label/icon on the black selected tab, even
                                             though it looks right as the 1.5px outline. -->
                                        <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="QrcodeScan" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="QR ORDER" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- cart -->
                <Grid Grid.Row="2">
                    <TextBlock Text="CART IS EMPTY" Foreground="{StaticResource TextFaint}" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsCartPanelVisible, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                    <Grid Visibility="{Binding IsCartPanelVisible, Converter={StaticResource CountToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Cart Header with Clear All button -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <!-- Standard Title (Visible when HasExistingOrder is False) -->
                            <TextBlock Text="ORDER ITEMS" Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                       Visibility="{Binding HasExistingOrder, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>

                            <!-- Tabs (Visible when HasExistingOrder is True) -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding HasExistingOrder, Converter={StaticResource CountToVis}}">
                                <!-- OLD ORDER Tab Button -->
                                <Button Content="OLD ORDER" Command="{Binding ShowOldTabCommand}" Height="24" Padding="8,0" Margin="0,0,6,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" BorderThickness="0,0,0,2.5" BorderBrush="Transparent" Padding="4,2,4,4">
                                                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{StaticResource TextMuted}"
                                                                        FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding DataContext.SelectedCartTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="Old">
                                                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <!-- NEW ORDER Tab Button -->
                                <Button Content="NEW ORDER" Command="{Binding ShowNewTabCommand}" Height="24" Padding="8,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="b" BorderThickness="0,0,0,2.5" BorderBrush="Transparent" Padding="4,2,4,4">
                                                            <TextBlock x:Name="txt" Text="{TemplateBinding Content}" Foreground="{StaticResource TextMuted}"
                                                                        FontSize="11" FontWeight="Bold"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding DataContext.SelectedCartTab, RelativeSource={RelativeSource AncestorType=Window}}" Value="New">
                                                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <Button Command="{Binding ClearCartCommand}" HorizontalAlignment="Right">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <!-- Normal text colour at rest, red on hover — same as the
                                             other links. The icon and label must not set Foreground
                                             themselves: a local value outranks the template trigger,
                                             so the hover colour would never reach them. -->
                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" CornerRadius="6" Background="Transparent" Padding="6,3">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                       VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock Text="CLEAR ALL" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#26EF4444"/>
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Inline Extra Form -->
                        <Border Grid.Row="1" Background="{StaticResource CardBg2}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                                CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                                Visibility="{Binding IsAddingExtra, Converter={StaticResource CountToVis}}">
                            <StackPanel>
                                <TextBlock Text="ADD EXTRA CHARGE" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Price -->
                                    <Border Grid.Column="0" Background="{StaticResource WindowBg}" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="6,3" Margin="0,0,8,0">
                                        <Grid>
                                            <TextBlock Text="₹" Foreground="{StaticResource TextMuted}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TxtExtraPrice" GotFocus="ExtraInput_GotFocus" KeyDown="TxtExtraPrice_KeyDown" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" FontWeight="Bold" CaretBrush="{DynamicResource Accent}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Remarks -->
                                    <Border Grid.Column="1" Background="{StaticResource WindowBg}" CornerRadius="6" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="6,3">
                                        <Grid>
                                            <TextBlock Text="Remarks (e.g. Extra Charge)" Foreground="{StaticResource TextFaint}" FontSize="12" VerticalAlignment="Center" Margin="2,0,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtExtraRemarks}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox x:Name="TxtExtraRemarks" GotFocus="ExtraInput_GotFocus" KeyDown="TxtExtraRemarks_KeyDown" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" CaretBrush="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Add" Click="BtnAddExtra_Click" Style="{StaticResource ActionBtn}" Width="50" Height="28" FontSize="11" FontWeight="Bold" Background="{DynamicResource AccentGrad}" Foreground="White"/>
                                        <Button Content="✕" Click="BtnCancelExtra_Click" Style="{StaticResource Stepper}" Width="28" Height="28" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="CartListBox" Grid.Row="2" ItemsSource="{Binding DisplayCartItemsView}" Background="Transparent" BorderThickness="0" SelectionMode="Single" Padding="0" PreviewKeyDown="CartListBox_PreviewKeyDown">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource WindowBg}" Padding="8,4" CornerRadius="6" Margin="0,8,0,4" HorizontalAlignment="Left">
                                                <TextBlock x:Name="HeaderTxt" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="True">
                                                    <Setter TargetName="HeaderTxt" Property="Text" Value="PARCEL ITEMS"/>
                                                    <Setter TargetName="HeaderTxt" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Name}" Value="False">
                                                    <Setter TargetName="HeaderTxt" Property="Text" Value="DINE-IN ITEMS"/>
                                                    <Setter TargetName="HeaderTxt" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Grid x:Name="g">
                                                    <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="6" Padding="12,4">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <!-- Left Selection Indicator Bar -->
                                                    <Rectangle x:Name="ind" Width="3.5" HorizontalAlignment="Left" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#2A00704A"/>
                                                        <Setter TargetName="ind" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#0F00704A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Single Item Delete Button (Left side) -->
                                        <Button Grid.Column="0" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Delete Item">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Width="26" Height="26" CornerRadius="6" Background="Transparent">
                                                                    <TextBlock x:Name="ic" Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                               Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="#33EF4444"/>
                                                                        <Setter TargetName="ic" Property="Foreground" Value="#FFEF4444"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Item Name & Editable Unit Price -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                <Border Background="{DynamicResource AccentFaint}" CornerRadius="4" BorderBrush="{DynamicResource Accent}" BorderThickness="1" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsParcel, Converter={StaticResource CountToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="P#" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Qty}" Foreground="{DynamicResource Accent}" FontSize="9.5" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Border Background="Transparent" CornerRadius="4" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0,2,0,0" HorizontalAlignment="Left" Cursor="IBeam">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="₹" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,2,0"/>
                                                    <TextBox x:Name="PriceInput" Style="{StaticResource PriceCellEditBox}"
                                                             GotFocus="PriceInput_GotFocus" KeyDown="PriceInput_KeyDown"
                                                             PreviewMouseLeftButtonDown="CellEditor_PreviewMouseLeftButtonDown"
                                                             PreviewTextInput="PriceInput_PreviewTextInput"
                                                             Text="{Binding PriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center" MinWidth="45" TextAlignment="Left"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Steppers, Editable Quantity & Line Total -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                            <Button Style="{StaticResource Stepper}" Content="–" Width="24" Height="24" FontSize="12"
                                                    Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <TextBox x:Name="QtyInput" Style="{StaticResource CellEditBox}"
                                                     KeyDown="QtyInput_KeyDown" GotFocus="QtyInput_GotFocus" LostFocus="QtyInput_LostFocus" PreviewMouseLeftButtonDown="CellEditor_PreviewMouseLeftButtonDown" PreviewTextInput="QtyInput_PreviewTextInput"
                                                     Text="{Binding QtyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinWidth="48" MaxLength="3" TextAlignment="Center"
                                                     VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource Stepper}" Content="+" Width="24" Height="24" FontSize="12"
                                                    Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
