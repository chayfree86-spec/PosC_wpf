                                <Style TargetType="Button">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" CornerRadius="8" Background="{DynamicResource AccentGrad}" RenderTransformOrigin="0.5,0.5">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="t1" Text="PRINT KOT" Foreground="White" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="t2" Text="[F3]" Foreground="#FFFFE0C0" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
