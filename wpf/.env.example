# ============================================================================
# POS till (WPF) — deployment settings
#
# Copy this file to ".env" and put it NEXT TO Pos.App.exe, or in
#   Documents\ChayChaupalPOS\.env
# (the executable's own folder wins if both exist).
#
# Nothing here is secret — it only says which server this counter talks to —
# but .env itself is git-ignored so each machine keeps its own.
# ============================================================================

# Where the POS API lives. Must include the /api suffix and no trailing slash.
#
#   local development (php -S 127.0.0.1:8123 dev-router.php)
POS_API_URL=http://127.0.0.1:8123/api
#
#   XAMPP / Apache on this machine
# POS_API_URL=http://localhost/PosC_wpf/api
#
#   live server
# POS_API_URL=https://posapi.chaychaupal.com/api

# Leave POS_API_URL out entirely and the till falls back to whatever is stored
# in app_settings['pos_api_base_url'], then to the built-in development default.
